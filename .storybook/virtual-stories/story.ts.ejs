import * as tested from '/<%= module %>';

const story = 'story' in tested ? await tested.story : UnimplementedStory;

const { component, args } = typeof story === 'function' ? {
  component: story,
  args: {}
} : story
                    

export default {
  component
}
    
export const <%= story %> = {
  args: typeof args === 'function' ? await args() : args
};        


function UnimplementedStory(){
  return '🏗️ Story is not implemented.'
}